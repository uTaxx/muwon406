# LCIP Pilot — 환경변수 예시 (실제 값은 .env에만 저장, Git에 커밋 금지)
# Round 7 Connection Readiness(docs/CONNECTION_READINESS.md)로 누락되어 있던
# Naver/모델 3종/테스트 수신 이메일 환경변수를 추가했다 — 실제 값은 여전히 비어 있다.

# --- Anthropic ---
ANTHROPIC_API_KEY=
# config/model_registry.yaml의 model_env 3종 — .env가 최우선(Registry보다 먼저 조회됨)
LCIP_CLASSIFICATION_MODEL=
LCIP_DEEP_ANALYSIS_MODEL=
LCIP_FUTURE_READINESS_MODEL=

# --- Google ---
# OAuth Desktop App 방식 사용 시
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_TOKEN_PATH=./credentials/token.json
# Service Account 방식 사용 시
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SHEETS_MASTER_SPREADSHEET_ID=

# --- n8n Cloud ---
N8N_BASE_URL=
N8N_API_KEY=
N8N_PROJECT_ID=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Gmail ---
GMAIL_SENDER_ADDRESS=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_TOKEN_PATH=./credentials/gmail_token.json

# --- DART (선택, TASK-006 확장 단계) ---
DART_API_KEY=

# --- Naver (config/sources.yaml SRC-0003, 선택) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 테스트 발송 수신처 (Email/Telegram Preview용, config/notification.yaml) ---
LCIP_TEST_EMAIL_RECIPIENT=

# --- 운영 모드 ---
# true인 동안에는 실제 외부 쓰기(Drive/Sheets/n8n/이메일/Telegram)를 금지한다.
LCIP_DRY_RUN=true
