{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lcip-pilot.local/schemas/claude_output.schema.json",
  "title": "ClaudeOutput",
  "description": "Master Pipeline의 Rule Filter/AI Analyze 단계(舊 WF-P04 Relevance Classifier / WF-P05 Risk Analysis, ADR-007로 통합됨)에서 나오는 Claude API 응답 검증 스키마 — TASK-011 / DEVELOPMENT_MANUAL_REFERENCE.md §7 Step 4/5 기준. mission_subcategory는 knowledge/MISSION_FRAMEWORK.md 기준.",
  "oneOf": [
    { "$ref": "#/$defs/relevance_output" },
    { "$ref": "#/$defs/risk_analysis_output" }
  ],
  "$defs": {
    "mission_subcategory": {
      "type": ["string", "null"],
      "enum": [
        "ma", "carve_out", "bolt_on", "jv", "venture", "capital_market",
        "technology", "new_business",
        "product_liability", "environmental", "safety", "fx", "raw_material",
        "supply_chain", "regulatory", "litigation", "policy", "esg",
        null
      ]
    },
    "relevance_output": {
      "type": "object",
      "required": [
        "relevant", "relevance_score", "mission", "related_companies", "reason",
        "needs_deep_analysis"
      ],
      "properties": {
        "relevant": { "type": "boolean" },
        "relevance_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "mission": { "type": "string", "enum": ["future_readiness", "risk_management"] },
        "mission_subcategory": { "$ref": "#/$defs/mission_subcategory" },
        "related_companies": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string" },
        "needs_deep_analysis": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "risk_analysis_output": {
      "type": "object",
      "required": [
        "facts", "significance", "lx_impact", "actions", "confidence", "evidence",
        "unknowns"
      ],
      "properties": {
        "facts": { "type": "array", "items": { "type": "string" } },
        "significance": { "type": "string" },
        "mission_subcategory": { "$ref": "#/$defs/mission_subcategory" },
        "lx_impact": { "type": "array", "items": { "type": "string" } },
        "actions": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
        "evidence": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "unknowns": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
