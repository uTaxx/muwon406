{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lcip-pilot.local/schemas/intelligence.schema.json",
  "title": "Intelligence",
  "description": "INTELLIGENCE_DB 레코드 — 03_BUILD_SPECIFICATION.md TASK-003 필수필드 기준. 사실·해석·추론·제안을 명확히 분리한다. mission_category/mission_subcategory는 knowledge/MISSION_FRAMEWORK.md 기준이며, Architect Review Round 3(Q3)에 따라 처음부터 배열(Array)로 설계한다 — 기사 하나가 미래준비·리스크관리 두 축에 동시에 걸치는 경우가 흔하기 때문이다. intelligence_categories는 knowledge/INTELLIGENCE_TAXONOMY.md(TASK-004E) 기준 — mission_category(목적 축)와 독립적인 도메인 축이다.",
  "type": "object",
  "required": [
    "intelligence_id", "article_ids", "mission_category", "intelligence_categories",
    "fact_summary", "verified_facts", "importance_level",
    "ai_interpretation", "ai_inference", "lx_impact", "recommended_actions",
    "unknowns", "confidence_score", "evidence", "created_at", "prompt_version",
    "knowledge_version"
  ],
  "properties": {
    "intelligence_id": { "type": "string", "pattern": "^INT-[0-9]{8}-[0-9]{4}$" },
    "article_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ART-[0-9]{8}-[0-9]{4}$" },
      "minItems": 1
    },
    "mission_category": {
      "type": "array",
      "items": { "type": "string", "enum": ["future_readiness", "risk_management"] },
      "minItems": 1,
      "uniqueItems": true,
      "description": "해당하는 미션 축 전부. 하나의 Article이 두 축에 동시에 걸치면 둘 다 포함한다."
    },
    "mission_subcategory": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ma", "carve_out", "bolt_on", "jv", "venture", "capital_market",
          "technology", "new_business",
          "product_liability", "environmental", "safety", "fx", "raw_material",
          "supply_chain", "regulatory", "litigation", "policy", "esg"
        ]
      },
      "uniqueItems": true,
      "description": "knowledge/MISSION_FRAMEWORK.md의 세부 카테고리 전부(복수 가능). 원문에서 명확하지 않으면 빈 배열."
    },
    "intelligence_categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "government", "policy", "technology", "investment", "ma", "competitor",
          "customer", "supplier", "raw_material", "esg", "product", "financial",
          "capital_market", "risk", "opportunity", "litigation", "regulation",
          "supply_chain", "macro"
        ]
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "knowledge/INTELLIGENCE_TAXONOMY.md의 19개 도메인 카테고리 중 해당하는 전부. AI는 모든 기사를 이 Taxonomy에 매핑해야 한다."
    },
    "fact_summary": { "type": "string", "minLength": 1 },
    "importance_level": {
      "type": "string",
      "enum": ["긴급", "중요", "참고"],
      "description": "뉴스 수집 실체화 라운드(2026-08-08) 신설. knowledge/STRATEGY_PLAYBOOK.md §2 기준을 그대로 승격 — risk_analysis_output의 importance_level을 그대로 옮긴다(scripts/pipeline/generate_intelligence.py). 긴급/중요만 알림 발송 대상."
    },
    "verified_facts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "원문에서 직접 확인 가능한 사실만"
    },
    "ai_interpretation": {
      "type": "array",
      "items": { "type": "string" },
      "description": "사실에 대한 AI의 해석 (사실 자체와 구분)"
    },
    "ai_inference": {
      "type": "array",
      "items": { "type": "string" },
      "description": "원문에 명시되지 않은 AI의 추론 (해석보다 불확실성 높음)"
    },
    "lx_impact": {
      "type": "array",
      "items": { "type": "string" },
      "description": "LX홀딩스/계열사 관점의 영향 — 근거 없는 단정 금지"
    },
    "recommended_actions": { "type": "array", "items": { "type": "string" } },
    "unknowns": {
      "type": "array",
      "items": { "type": "string" },
      "description": "확인되지 않아 추가 조사가 필요한 사항"
    },
    "confidence_score": { "type": "string", "enum": ["low", "medium", "high"] },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "minItems": 1
    },
    "created_at": { "type": "string", "format": "date-time" },
    "prompt_version": { "type": "string" },
    "knowledge_version": { "type": "string" }
  },
  "additionalProperties": false
}
