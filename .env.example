# 데이터 소스: mock(기본, API 키 불필요) | kakao | naver | google
VITE_DATA_SOURCE=mock

# 카카오맵 JS 키 (지도 표시용)
# 발급: https://developers.kakao.com/console/app -> 내 애플리케이션 -> JavaScript 키
VITE_KAKAO_MAP_KEY=

# 카카오 로컬 검색 REST API 키 (장소 검색용, 지도 JS 키와 다릅니다)
# 발급: https://developers.kakao.com/console/app -> 내 애플리케이션 -> REST API 키
VITE_KAKAO_REST_API_KEY=

# 네이버 검색 API (지역 검색용) - 실제 호출은 CORS 문제로 서버 프록시가 필요합니다
# 발급: https://developers.naver.com/apps
VITE_NAVER_CLIENT_ID=
VITE_NAVER_CLIENT_SECRET=

# 구글 플레이스 API - 실제 호출은 서버 프록시가 필요합니다
# 발급: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_PLACES_KEY=
