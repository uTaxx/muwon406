# DB 접속 정보와 암호화 키만 .env로 관리합니다.
# KIS 앱키/텔레그램 토큰/리스크 정책은 여기 두지 않고 DB(app_settings 테이블)에
# 저장되며, scripts/configure.py 또는 (Phase 2+) 대시보드로 넣고 바꿉니다.
# 자세한 설계는 docs/config_architecture.md 참고.

DATABASE_URL=sqlite:///./muwon.db

# 비밀값(KIS 앱시크릿, 텔레그램 토큰 등) 암호화 키. 아래 명령으로 생성해서 채우세요:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 분실하면 저장된 비밀값을 복호화할 수 없으니 안전하게 보관하세요.
MUWON_MASTER_KEY=
