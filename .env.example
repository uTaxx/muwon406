# KIS Developers 앱키/시크릿키 (docs/kis_api_setup.md 참고)
# KIS_ENV: paper(모의투자) | real(실전투자) — 항상 paper로 시작할 것
KIS_ENV=paper
KIS_APP_KEY=
KIS_APP_SECRET=
# 계좌번호 앞 8자리
KIS_ACCOUNT_NO=
# 계좌번호 뒤 2자리 (상품코드), 보통 01
KIS_ACCOUNT_PRODUCT_CD=01

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DATABASE_URL=sqlite:///./muwon.db
