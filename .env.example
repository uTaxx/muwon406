# 데이터 소스: mock(기본, API 키 불필요) | live(n8n 실시간 검색 웹훅) | kakao | naver | google
VITE_DATA_SOURCE=mock

# n8n 실시간 검색 웹훅 URL (VITE_DATA_SOURCE=live 일 때 사용)
# 검색어가 있으면 카카오 실시간 검색 + 구글시트 누적 저장, 없으면 지금까지 쌓인 전체 목록 반환
VITE_N8N_SEARCH_WEBHOOK_URL=https://sondullab.app.n8n.cloud/webhook/matjib-search

# n8n 블로그 리뷰 검색 웹훅 URL (가게 카드를 펼칠 때 사용)
# 설정하면 네이버 블로그 검색으로 실제 후기를 가져와 광고성 여부를 분석합니다.
# 비워두면 데모용 가짜 리뷰(generateReviews.ts)로 대체됩니다.
VITE_N8N_REVIEW_WEBHOOK_URL=https://sondullab.app.n8n.cloud/webhook/matjib-reviews

# 카카오맵 JS 키 (지도 표시용)
# 발급: https://developers.kakao.com/console/app -> 내 애플리케이션 -> JavaScript 키
VITE_KAKAO_MAP_KEY=

# 카카오 로컬 검색 REST API 키 (장소 검색용, 지도 JS 키와 다릅니다)
# 발급: https://developers.kakao.com/console/app -> 내 애플리케이션 -> REST API 키
VITE_KAKAO_REST_API_KEY=

# 네이버 검색 API (지역 검색용) - 실제 호출은 CORS 문제로 서버 프록시가 필요합니다
# 발급: https://developers.naver.com/apps
VITE_NAVER_CLIENT_ID=
VITE_NAVER_CLIENT_SECRET=

# 구글 플레이스 API - 실제 호출은 서버 프록시가 필요합니다
# 발급: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_PLACES_KEY=
